# Production requires the actual HTTPS origin. Never derive it from a request Host header.
PUBLIC_ORIGIN=http://localhost:5173
# Mount the parent directory on persistent storage in production (single Machine).
DATABASE_PATH=./data/ride-remix.sqlite
# Set both to enable delivery. Without them, local practice works but no emails are sent.
RESEND_API_KEY=
EMAIL_FROM=
# Required in production. Create a Non-interactive Turnstile widget for PUBLIC_ORIGIN's hostname.
# The public site key is served by the API. Keep the secret in server/Fly secrets.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# direct for local development. Fly uses its IPv4-only listener and edge header.
CLIENT_IP_MODE=direct
# Optional override for explicit peer validation outside the Fly IPv4-only topology.
TRUSTED_PROXY_CIDRS=
