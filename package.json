{
  "name": "ride-remix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build && tsup src/server/index.ts src/server/auth/cli.ts src/server/auth/sql.ts --format esm --platform node --target node24 --out-dir dist/server --clean",
    "start": "node dist/server/index.js",
    "check": "npm run lint && npm test && npm run build",
    "test": "tsx --test src/**/*.test.ts",
    "auth": "tsx src/server/auth/cli.ts",
    "contracts:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7"
  }
}
